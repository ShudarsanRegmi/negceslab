server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_name | default('_') }};

    root /home/{{ target_user }}/negceslab/client/dist;
    index index.html;

    # Handle root / request redirect or serving index.html
    location = / {
        try_files /index.html =404;
    }

    # Serve Vite assets and subpaths for /negces/ base path
    location /negces/ {
        alias /home/{{ target_user }}/negceslab/client/dist/;
        try_files $uri $uri/ /index.html;
    }

    # Also handle assets requests directly if requested without prefix
    location /assets/ {
        alias /home/{{ target_user }}/negceslab/client/dist/assets/;
    }

    # Reverse proxy backend API requests to Node.js Podman container (port 5001)
    location /api/ {
        proxy_pass http://127.0.0.1:5001/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
