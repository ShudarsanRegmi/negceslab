pipeline {
    agent any

    environment {
        PROD_SERVER = 'negces@172.19.18.5'
        PROD_WEB_DIR = '/data/Intranet/negces/negceslab'
        SSH_KEY_PATH = '/home/aparichit/.ssh/id_campus'
    }

    triggers {
        // Poll GitHub SCM every 5 minutes for new commits (LAN / No Public IP friendly)
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo "[STAGE 1] Syncing code from GitHub repository..."
                git branch: 'main', url: 'https://github.com/ShudarsanRegmi/negceslab.git'
            }
        }

        stage('2. Install Web Dependencies') {
            steps {
                echo "[STAGE 2] Installing Node.js packages for Server and Client..."
                sh 'cd server && npm ci'
                sh 'cd client && npm ci'
            }
        }

        stage('3. Run Automated Tests') {
            steps {
                echo "[STAGE 3] Executing Server and Client test suites..."
                sh 'cd server && npm test'
                sh 'cd client && npm test'
                sh 'node test/isolated_tests/test_outlook_email.js'
            }
        }

        stage('4. Build Web Production Bundle') {
            steps {
                echo "[STAGE 4] Compiling React Vite production assets..."
                sh 'cd client && npm run build'
            }
        }

        stage('5. Deploy Web App & Restart Server') {
            steps {
                echo "[STAGE 5] Pulling latest code on Production Server & restarting Node backend..."
                sh '''
                    ssh -O -i ${SSH_KEY_PATH} ${PROD_SERVER} "cd ${PROD_WEB_DIR} && git pull origin main && cd server && npm install && pm2 restart all"
                '''
            }
        }

        stage('6. Post-Deployment Verification') {
            steps {
                echo "[STAGE 6] Performing production endpoint health check..."
                sh '''
                    ssh -O -i ${SSH_KEY_PATH} ${PROD_SERVER} "curl -s -f http://localhost:5000/api/health || true"
                '''
            }
        }
    }

    post {
        success {
            echo "=================================================================="
            echo " [SUCCESS] NEGCES Lab Web CI/CD Pipeline Completed Successfully! "
            echo "=================================================================="
        }
        failure {
            echo "=================================================================="
            echo " [FAILURE] CI/CD Pipeline failed. Check console log for details."
            echo "=================================================================="
        }
    }
}
