pipeline {
    agent any

    tools {
        // Configured in Jenkins -> Manage Jenkins -> Tools -> NodeJS
        nodejs 'NodeJS-18'
    }

    environment {
        // Read environment properties configured in Jenkins (with fallback defaults)
        PROD_USER     = "${env.PROD_USER ?: 'negces'}"
        PROD_HOST     = "${env.PROD_HOST ?: '172.19.18.5'}"
        PROD_WEB_DIR  = "${env.PROD_WEB_DIR ?: '/data/Intranet/negces/negceslab'}"
        SSH_KEY_ID    = "${env.SSH_KEY_ID ?: 'campus-ssh-key'}"
    }

    triggers {
        // Poll GitHub SCM every 5 minutes for new commits (LAN / No Public IP friendly)
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo "[STAGE 1] Syncing code from GitHub repository..."
                git branch: 'main', url: 'https://github.com/ShudarsanRegmi/negceslab.git'
            }
        }

        stage('2. Install Web Dependencies') {
            steps {
                echo "[STAGE 2] Installing Node.js packages for Server and Client..."
                sh 'cd server && npm ci'
                sh 'cd client && npm ci'
            }
        }

        stage('3. Run Automated Tests') {
            steps {
                echo "[STAGE 3] Executing Server and Client test suites..."
                sh 'cd server && npm test'
                sh 'cd client && npm test'
                sh 'node test/isolated_tests/test_outlook_email.js'
            }
        }

        stage('4. Build Web Production Bundle') {
            steps {
                echo "[STAGE 4] Compiling React Vite production assets..."
                sh 'cd client && npm run build'
            }
        }

        stage('5. Deploy Web App Containers via Podman (Makefile)') {
            steps {
                echo "[STAGE 5] Pulling latest code on Production Server & executing Podman container replacements (Backend first, then Frontend)..."
                sshagent([SSH_KEY_ID]) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ${PROD_USER}@${PROD_HOST} "cd ${PROD_WEB_DIR} && git pull origin main && make down-backend && make build-backend && make up-backend && make build-frontend-fresh"
                    '''
                }
            }
        }

        stage('6. Post-Deployment Container Health Check') {
            steps {
                echo "[STAGE 6] Performing production Podman container health check..."
                sshagent([SSH_KEY_ID]) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ${PROD_USER}@${PROD_HOST} "cd ${PROD_WEB_DIR} && make health"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "=================================================================="
            echo " [SUCCESS] NEGCES Lab Podman Web CI/CD Pipeline Completed!       "
            echo "=================================================================="
        }
        failure {
            echo "=================================================================="
            echo " [FAILURE] CI/CD Pipeline failed. Check console log for details."
            echo "=================================================================="
        }
    }
}
